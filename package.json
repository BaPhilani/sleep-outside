{
  "name": "pavi-solar-system-size-calculator",
  "version": "2.0.0",
  "description": "Solar System Size Calculator for PAVI Projects - Calculate energy needs and recommended solar system sizes",
  "main": "server.js",
  "scripts": {
    "start": "npm run build && node server.js",
    "dev": "vite",
    "build": "vite build --emptyOutDir",
    "lint": "eslint *.js src/**/*.js",
    "format": "prettier --ignore-path ./.gitignore --write \"./**/*.{html,json,js,ts,css}\"",
    "test": "jest"
  },
  "author": "Shane Thompson & BaPhilani",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "vite": "^5.4.7"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "browserslist": [
    "last 3 and_chr versions",
    "last 3 chrome versions",
    "last 3 opera versions",
    "last 3 ios_saf versions",
    "last 3 safari versions"
  ],
  "engines": {
    "node": "18.x"
  }
}